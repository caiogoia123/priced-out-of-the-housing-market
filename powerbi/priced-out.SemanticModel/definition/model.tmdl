model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["OECD_Anual","fOECD","dPais","dMedida"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table fOECD
ref table dPais
ref table dMedida
ref table _Medidas

ref cultureInfo pt-BR

